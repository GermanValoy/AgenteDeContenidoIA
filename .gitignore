# Copias comprimidas solo para subir a YouTube (se regeneran desde el video original)
*_yt.mp4
# Temporales del montaje
shorts/*/tmp/

# Versiones para TikTok (se regeneran con tiktok/hook.txt)
*_tiktok.mp4

# Clipping: material descargado, temporales y clips (se regeneran con build.py)
clipping/fuentes/*.mp4
clipping/fuentes/*.part
clipping/lovable/tmp/
clipping/lovable/salida/
